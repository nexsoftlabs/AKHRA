# PostgreSQL (local Docker)
POSTGRES_DB=movieplatform
POSTGRES_USER=movieplatform
POSTGRES_PASSWORD=movieplatform_dev
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=movieplatform;Username=movieplatform;Password=movieplatform_dev

# Redis
ConnectionStrings__Redis=localhost:6379

# Frontend
# Leave empty in dev to use Vite proxy (/api → http://localhost:5017)
VITE_API_BASE_URL=
# Google Sign-In (same OAuth 2.0 Web client ID in both places)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173
# Authorized redirect URIs: not required for GIS One Tap / button (ID token flow)
VITE_GOOGLE_CLIENT_ID=

# Auth
Auth__GoogleClientId=
Email__SmtpHost=
Email__SmtpUser=
Email__SmtpPassword=
Email__PublicWebBaseUrl=http://localhost:5173
Sms__AccountSid=
Sms__FromNumber=
Sms__ProviderApiKey=
# Google client secret stays server-side only if using server OAuth code flow (not required for ID token POST /auth/google)
Jwt__SigningKey=
Sms__ProviderApiKey=

# Razorpay (Phase 5+)
Razorpay__KeyId=
Razorpay__KeySecret=
Razorpay__WebhookSecret=

# AWS media (Phase 4+)
AWS__Region=ap-south-1
AWS__MediaBucket=
Media__S3Bucket=
Media__S3Region=ap-south-1
Media__CloudFrontDomain=
Media__CloudFrontKeyPairId=
Media__CloudFrontPrivateKeyPem=
AWS__CloudFrontDomain=
AWS__CloudFrontKeyPairId=
# Private key via secret manager — never commit
